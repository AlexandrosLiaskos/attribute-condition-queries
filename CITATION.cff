    given-names: Alexandros
    affiliation: "National and Kapodistrian University of Athens"
    orcid: "https://orcid.org/0009-0003-0568-945X"
license: AGPL-3.0-only
repository-code: "https://github.com/AlexandrosLiaskos/attribute-condition-queries"
version: 0.1.0
keywords:
  - query builder
  - web mapping
  - data catalogues
  - filtering
  - security
