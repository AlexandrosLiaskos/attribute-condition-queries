{
  "name": "attribute-condition-queries",
  "version": "0.1.0",
  "description": "Attribute condition queries without code evaluation: conditions on the fields of records joined with AND and OR, evaluated without eval, read back as a sentence with brackets in English or Greek, checked with messages for the person, and written into a URL.",
  "keywords": [
    "query",
    "query-builder",
    "filter",
    "conditions",
    "web-mapping",
    "gis",
    "no-eval"
  ],
  "license": "AGPL-3.0-only",
  "author": "Alexandros Liaskos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandrosLiaskos/attribute-condition-queries.git"
  },
  "homepage": "https://github.com/AlexandrosLiaskos/attribute-condition-queries#readme",
  "bugs": "https://github.com/AlexandrosLiaskos/attribute-condition-queries/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CITATION.cff"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run types && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
